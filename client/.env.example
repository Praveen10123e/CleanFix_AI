# ClassFix AI Frontend Environment Configuration
# Copy this file to .env or .env.local for local overrides

# Backend API Base URL (FastAPI / backend service)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application Environment ('development', 'staging', 'production')
VITE_APP_ENV=development

# Google Workspace OAuth Client ID for institutional Single Sign-On
VITE_GOOGLE_CLIENT_ID=
